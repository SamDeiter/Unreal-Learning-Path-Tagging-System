rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Query logs - allow writes with rate limiting and validation
    match /query_logs/{logId} {
      // Anyone can write a query log (for analytics)
      // But with strict validation to prevent abuse
      allow create: if 
        // Must be authenticated
        request.auth != null &&
        // Must have required fields
        request.resource.data.keys().hasAll(['query', 'timestamp']) &&
        // Query must be a string, max 200 chars (prevent large payloads)
        request.resource.data.query is string &&
        request.resource.data.query.size() <= 200 &&
        // Timestamp must be server timestamp
        request.resource.data.timestamp == request.time &&
        // Limit document size (prevent abuse)
        request.resource.data.keys().size() <= 5;
      
      // No reads from client (admin only via console)
      allow read: if false;
      
      // No updates or deletes
      allow update, delete: if false;
    }
    
    // Path ratings - allow creating feedback
    match /path_ratings/{ratingId} {
      allow create: if 
        request.auth != null &&
        request.resource.data.keys().hasAll(['path_id', 'rating', 'timestamp']) &&
        request.resource.data.rating in ['up', 'down'] &&
        request.resource.data.timestamp == request.time &&
        request.resource.data.keys().size() <= 5;
      allow read, update, delete: if false;
    }
    
    // Cached paths — backend-only. Client reads must go through a Cloud Function
    // so cached payloads (which include original user queries) are never
    // enumerable from the client SDK.
    match /cached_paths/{pathId} {
      allow read: if false;
      allow write: if false;
    }
    
    // Helper: check if user is admin (via Firebase custom claims)
    // Set via setAdminClaim Cloud Function (bootstrap list handles first-time seeding)
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    
    // Invite codes — admin creates/lists/revokes, users read + consume
    match /path_builder_invites/{code} {
      // Admin can do anything
      allow read, write: if isAdmin();
      // Authenticated users can read individual invites (to validate)
      allow get: if request.auth != null;
      // Authenticated users can update usedCount when consuming
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount', 'lastUsedAt'])
        && request.resource.data.usedCount == resource.data.usedCount + 1
        && request.resource.data.lastUsedAt == request.time;
    }
    
    // Access allowlist — admin manages, users can read own + create via invite
    match /path_builder_access/{email} {
      // Admin can do anything
      allow read, write: if isAdmin();
      // Users can read their own access doc
      allow get: if request.auth != null && request.auth.token.email == email;
      // Users can create their own access entry (when consuming invite)
      allow create: if request.auth != null && request.auth.token.email == email;
    }
    
    // Adaptive carts — per-user isolation (Google Auth required)
    match /adaptive_carts/{cartId} {
      // Users can only read their own carts
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      // Users can only create carts owned by themselves
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      // Users can only update/delete their own carts
      allow update, delete: if request.auth != null
                            && resource.data.userId == request.auth.uid;
    }

    // Cached diagnoses — backend-only. Stored payloads include the original
    // user query text; public read would let any authenticated user enumerate
    // other users' troubleshooting history. All reads go through Cloud
    // Functions (handleProblemFirst) which filter by uid.
    match /cached_diagnoses/{docId} {
      allow read: if false;
      allow write: if false; // Cloud Functions only (Admin SDK bypasses rules)
    }

    // Path cache — backend-only for the same reason as cached_diagnoses:
    // the stored payload contains the raw query. Reads go through Cloud
    // Functions which enforce per-uid access.
    match /pathCache/{cacheId} {
      allow read: if false;
      allow write: if false; // Backend Cloud Functions only (Admin SDK bypasses rules)
    }

    // Feedback submissions — authenticated users can create, admin reads/manages
    match /feedback/{docId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['type', 'description', 'timestamp'])
        && request.resource.data.type in ['bug', 'feature', 'general', 'content', 'other']
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.keys().size() <= 10;
      allow read, update, delete: if isAdmin();
    }

    // API Usage analytics — admin can read (Cloud Functions write via Admin SDK)
    match /apiUsage/{docId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions only (Admin SDK bypasses rules)
    }

    // Analytics events — authenticated users can create, admin can read
    // (Restricted to prevent cross-user data leakage of queries/sessions)
    match /analytics_events/{docId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Step feedback — 👍/👎 quality signals on learning path steps
    // Authenticated users can create feedback, admin reads for content gap analysis
    match /stepFeedback/{docId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['sentiment', 'timestamp'])
        && request.resource.data.sentiment in ['positive', 'negative']
        && request.resource.data.keys().size() <= 10;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Token usage — client-side token tracking for cost dashboard
    // Authenticated users can read/write their own daily stats.
    // Nested path /token_usage/{userId}/daily/{dateKey} ensures isolation.
    match /token_usage/{userId}/daily/{dateKey} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().size() <= 15;
      allow delete: if false;
    }

    // Error logs — production crash monitoring
    // Authenticated users can write error reports, admin reads/manages
    match /errorLogs/{docId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['message', 'source', 'timestamp'])
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && request.resource.data.keys().size() <= 10;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Performance logs — client-side timing instrumentation
    // Authenticated users can write timing data, admin reads/manages
    match /performanceLogs/{docId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['label', 'durationMs', 'timestamp'])
        && request.resource.data.label is string
        && request.resource.data.label.size() <= 100
        && request.resource.data.durationMs is number
        && request.resource.data.keys().size() <= 10;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Embedding collections — public read (Cloud Functions serve via findNearest)
    // Writes are admin-only via Admin SDK (upload script)
    match /epic_embeddings/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /course_embeddings/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /segment_embeddings/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /docs_embeddings/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Digital tutor user state — per-user skill tracking + session history
    // Only the owning user can read/write their own doc and subcollections.
    // Cloud Functions (Admin SDK) bypass rules for server-side updates.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().size() <= 15;
      allow delete: if false;

      // Session history — written by tutor conversation flow (Wave 1A)
      match /sessions/{sessionId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().size() <= 20;
        allow delete: if false;
      }

      // Feedback signals tied to sessions (Wave 2)
      match /feedback/{feedbackId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasAll(['uid', 'sessionId', 'signal', 'createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.keys().size() <= 10;
        allow update, delete: if false;
      }

      // Generated interactive lessons — written by generateLesson Cloud Function (Admin SDK).
      // Owner-only reads so a learner can revisit their lesson pages.
      match /lessons/{lessonId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false; // Cloud Functions only (Admin SDK bypasses rules)
      }
    }

    // Demand intelligence — pre-computed by GitHub Action (Admin SDK write)
    // Public read (community demand scores are non-sensitive, same as cached_paths)
    match /demand_intel/{docId} {
      allow read: if true;
      allow write: if false; // GitHub Action only (Admin SDK bypasses rules)
    }

    // Misconception signals — raw append-only log feeding the mining pipeline.
    // Contains stems, picks, and comments from quiz/feedback; admin-read-only
    // to keep per-learner context out of client-visible collections. Writes
    // go through submitFeedback + ingestQuizResult (Admin SDK).
    match /misconceptionSignals/{docId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions only (Admin SDK bypasses rules)
    }

    // Misconception taxonomy — synthesized, named clusters the lesson and
    // diagnosis prompts read to preempt known misconceptions. Authenticated
    // learners can read (needed by Gemini prompts); writes are admin-only
    // via the mineMisconceptions callable.
    match /misconceptions/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // Cloud Functions only (Admin SDK bypasses rules)
    }

    // Default deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
