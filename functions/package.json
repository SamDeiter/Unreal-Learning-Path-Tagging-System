{
  "name": "ue5-learning-path-functions",
  "description": "Cloud Functions for UE5 Learning Path Builder",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
